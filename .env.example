# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml. `npm run db:up` starts it.
# The server starts even when this host is unreachable: /health/live stays up
# and only /health/ready reports the failure. See ARCHITECTURE.md.
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5432/boilerplate?schema=public

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated origins allowed by CORS. The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum accepted request body. Accepts any byte string the body parser understands.
BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Documentation
# ---------------------------------------------------------------------------
# Set to false in production to stop serving /api/docs.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=log

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required, at least 32 characters, and no default — a fallback would ship as a
# real secret. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Access token lifetime. Short on purpose: a leaked token expires by itself.
JWT_ACCESS_TTL_SECONDS=900

# Refresh session lifetime, in days.
REFRESH_TTL_DAYS=30

# Must be true in production — config validation refuses to start otherwise.
# False locally because the Vite dev server is plain HTTP and a Secure cookie
# would never be stored.
COOKIE_SECURE=false
# Leave empty unless the API and the app are on different subdomains.
COOKIE_DOMAIN=

# Login throttling, held in this process. Replace the adapter before running
# more than one instance.
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# Local demo account for `npm run prisma:seed`. Leave both empty to skip it.
# Never set in production; config validation rejects it there.
SEED_ADMIN_EMAIL=demo@example.com
SEED_ADMIN_PASSWORD=
